        <mxCell id="jg9azz3hMLn2XreTIip4-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFCCCC;align=left;" value="SPI_Read_Reg:&lt;br&gt;1.拉低CSN片选信号，选择从机&lt;div&gt;2.主机发送寄存器地址给从机，从机从它的发送寄存器回传数据，接收寄存器地址，再准备数据到发送区&lt;/div&gt;&lt;div&gt;3.再次发送0xFF，读取从机准备好的寄存器数据&lt;/div&gt;&lt;div&gt;4.拉高CSN&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="260" x="880" y="129" as="geometry" />
        </mxCell>
        <mxCell id="jg9azz3hMLn2XreTIip4-5" edge="1" parent="1" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0.869;entryDx=0;entryDy=0;entryPerimeter=0;dashed=1;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <Array as="points">
              <mxPoint x="770" y="310" />
            </Array>
            <mxPoint x="770" y="317" as="sourcePoint" />
            <mxPoint x="880" y="240.00000000000003" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="jg9azz3hMLn2XreTIip4-6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFCCCC;align=left;" value="&lt;div style=&quot;line-height: 19px;&quot;&gt;Spi_RW_Byte:&lt;/div&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;1.主机等待发送缓存区为空&lt;/div&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;2.主机将发送数据放到发送缓存区，硬件发送&lt;/div&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;3.同时，接收缓存区，接收从机回传数据&lt;/div&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;4.主机接收缓存区，装满了，RXNE置位&lt;/div&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;5.reurn 接收缓存区读取数据&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="260" x="1230" y="390" as="geometry" />
        </mxCell>
        <mxCell id="jg9azz3hMLn2XreTIip4-13" edge="1" parent="1" source="jg9azz3hMLn2XreTIip4-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="jg9azz3hMLn2XreTIip4-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="jg9azz3hMLn2XreTIip4-9" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFCCCC;align=left;" value="&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;SPI_Write_Reg:&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;0.拉低CSN&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;1.主机发送（命令+寄存器地址）得到从机返回状态&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;2.主机发送要写入的Value,从机返回无意义值&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;3.拉高CSN&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; line-height: 19px; white-space: pre;&quot;&gt;&lt;span style=&quot;font-style: italic;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="260" x="880" y="290" as="geometry" />
        </mxCell>
