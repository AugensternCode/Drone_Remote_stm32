          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="jg9azz3hMLn2XreTIip4-10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFCCCC;align=left;" value="&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;font style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;u8&lt;/span&gt; &lt;span style=&quot;color: rgb(97, 175, 239);&quot;&gt;SPI_Read_Buf&lt;/span&gt;(&lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;u8&lt;/span&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt;reg&lt;/span&gt;,&lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;u8&lt;/span&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(213, 95, 222);&quot;&gt;*&lt;/span&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt;pBuf&lt;/span&gt;,&lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;u8&lt;/span&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt;len&lt;/span&gt;)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 19px; color: rgb(171, 178, 191);&quot;&gt;&lt;font style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;1.拉低CSN&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 19px; color: rgb(171, 178, 191);&quot;&gt;&lt;font style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;2.Status=主机发送（命令字+寄存器地址）&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 19px; color: rgb(171, 178, 191);&quot;&gt;&lt;font style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;3.循环发送0xFF读取从机寄存器值，pBuf接收&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 19px; color: rgb(171, 178, 191);&quot;&gt;&lt;font style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;4.拉高CSN&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 19px; color: rgb(171, 178, 191);&quot;&gt;&lt;font style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;5.return Status&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-style: italic; white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="260" x="880" y="460" as="geometry" />
        </mxCell>
        <mxCell id="jg9azz3hMLn2XreTIip4-17" edge="1" parent="1" source="jg9azz3hMLn2XreTIip4-11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="jg9azz3hMLn2XreTIip4-6">
