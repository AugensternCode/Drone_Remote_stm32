        <mxCell id="TTFzDqPseFerfFGiZN-E-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;align=left;strokeColor=#6c8ebf;" value="&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;1.&lt;span style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; white-space: pre;&quot;&gt;txPacket&lt;/span&gt;&lt;span style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; white-space: pre; color: rgb(171, 178, 191);&quot;&gt;[&lt;/span&gt;&lt;span style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; white-space: pre; color: rgb(209, 154, 102);&quot;&gt;0&lt;/span&gt;&lt;span style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; white-space: pre; color: rgb(171, 178, 191);&quot;&gt;]=包头0xAA;&lt;/span&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; white-space: pre; color: rgb(171, 178, 191);&quot;&gt;2.&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; white-space: pre; color: rgb(239, 89, 111);&quot;&gt;txPacket&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; white-space: pre; color: rgb(171, 178, 191);&quot;&gt;[&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; white-space: pre; color: rgb(209, 154, 102);&quot;&gt;1&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; white-space: pre; color: rgb(171, 178, 191);&quot;&gt;]=plane.lock;上锁状态&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font face=&quot;Consolas, Courier New, monospace&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;3.&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; white-space: pre;&quot;&gt;txPacket&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; white-space: pre;&quot;&gt;[&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; white-space: pre;&quot;&gt;&lt;font&gt;2]=plane.power;电量&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;4.uint16_t temp=plane.voltage;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;5.txPacket[3]=*((u8*)&amp;amp;temp)取8位&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font face=&quot;Consolas, Courier New, monospace&quot; style=&quot;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;6.&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; white-space: pre; background-color: transparent; color: rgb(209, 154, 102);&quot;&gt;txPacket[4]=*((u8*)&amp;amp;temp+1)取后8位&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
